{
  "name": "ts-rogue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A TypeScript terminal dungeon crawler",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "changeset": "changeset",
    "check": "pnpm typecheck && pnpm test && pnpm lint",
    "docs:lint": "tsx scripts/lint-memory.ts",
    "eve:dev": "eve dev --no-ui",
    "pr:sandbox": "bash scripts/pr-sandbox.sh",
    "game": "tsx src/app.tsx",
    "game:dev": "tsx --env-file-if-exists=.env.local src/app.tsx --dev",
    "game:watch": "tsx --watch --env-file-if-exists=.env.local src/app.tsx --dev",
    "play": "bash scripts/play.sh",
    "play:sandbox": "bash scripts/play-sandbox.sh",
    "play:web": "node scripts/play-web.mjs",
    "web:build": "pnpm --filter @ts-rogue/web build",
    "web:dev": "pnpm --filter @ts-rogue/web dev",
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsgo --noEmit",
    "test:unit": "vitest run",
    "test": "pnpm test:unit",
    "lint": "biome ci src && biome lint agent",
    "format": "biome format --write .",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "@vercel/connect": "0.4.0",
    "ai": "^7.0.37",
    "eve": "^0.27.6",
    "ink": "^7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rot-js": "^2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.50.0",
    "sandbox": "3.5.2",
    "sharp": "^0.35.3",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4"
  }
}
