#!/bin/sh
# Warn (never block) when a push carries work with no Linear issue reference.
# Linear identifiers look like ROG-123 and may appear in the branch name or a commit subject.

branch=$(git rev-parse --abbrev-ref HEAD)
untracked=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "$local_sha" ] && continue
	if [ -z "$remote_sha" ] || echo "$remote_sha" | grep -qE '^0+$'; then
		base=$(git rev-parse --verify --quiet origin/main)
		[ -n "$base" ] && range="$base..$local_sha" || range="$local_sha"
	else
		range="$remote_sha..$local_sha"
	fi
	subjects=$(git log --format='%s%n%b' "$range" 2>/dev/null)
	echo "$branch $subjects" | grep -qiE 'ROG-[0-9]+' || untracked=1
done

if [ "$untracked" = "1" ]; then
	printf '\033[33m! No Linear issue reference (ROG-<n>) in the branch name or commit messages.\033[0m\n' >&2
	printf '  Track this work: create or open an issue at https://linear.app/rogue-ts/team/ROG\n' >&2
	printf '  then name the branch (e.g. nico/rog-42-fov) or a commit with its id. Pushing anyway.\n' >&2
fi

exit 0
